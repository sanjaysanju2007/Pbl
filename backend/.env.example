# Database Mode: 'firebase' or 'mongodb' (default: firebase)
DB_MODE=firebase

# Firebase Firestore Configuration
# Option 1: Path to serviceAccountKey.json (placed in backend/ directory)
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Option 2: Direct environment variables (alternative to file)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# MongoDB Connection (Fallback or Alternative)
MONGO_URI=mongodb://localhost:27017/chittukurumbakam

# Security & JWT Authentication
JWT_SECRET=chittukurumbakam_super_secret_jwt_key_2025_change_in_production
JWT_EXPIRE=7d

# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Email Notifications (SMTP: Gmail, SendGrid, Resend, or AWS SES)
# Leave placeholder values in development for simulated safe logging
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_school_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=admissions@chittukurumbakam.com
FROM_NAME=Chittukurumbakam Play School
ADMIN_ALERT_EMAIL=principal@chittukurumbakam.com
